{
  "name": "@atlasium/visez",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm test && pnpm lint && next build",
    "start": "pnpm run db:migrate && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "readiness": "tsx scripts/check-readiness.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "auth:hash": "node scripts/hash-secret.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "0.7.0-beta",
    "@neon/config": "1.9.3",
    "next": "16.2.6",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.34.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
