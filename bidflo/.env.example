# Lakebase Postgres on Neon (pooled connection for the app)
DATABASE_URL=

# Neon Managed Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
BIDFLO_ALLOWED_EMAILS=blair@example.com

# GPT through a dedicated OpenAI Platform API key stored ONLY in Render.
# The older backend-connect key was revoked; never reuse or publish it.
# Neon AI Gateway is unavailable on the current Neon Free plan.
# If AI_API_KEY is blank, BidFlo prepares drafts needing human review.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_REVIEW_MODEL=gpt-5-mini

# Signed inbound email + notifications
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
UPWORK_ALLOWED_SENDERS=upwork@example.com
BIDFLO_OWNER_EMAIL=
BIDFLO_EMAIL_FROM=BidFlo <notifications@example.com>

# Slack notifications to the owner's DM. Enter secrets privately in Render.
# SLACK_BOT_TOKEN and SLACK_DESTINATION_ID (owner's U... ID) require
# a Slack app with chat:write and im:write. The bot must be installed.
# Alternatively set an incoming webhook tied to a private channel.
# ChatGPT's connected @Slack app does NOT supply BidFlo's bot credential.
SLACK_BOT_TOKEN=
SLACK_DESTINATION_ID=
SLACK_WEBHOOK_URL=

# Scheduled processing and optional permitted submission bridge
CRON_SECRET=
BIDFLO_URL=http://localhost:3000
UPWORK_SUBMISSION_WEBHOOK_URL=
UPWORK_SUBMISSION_TOKEN=
