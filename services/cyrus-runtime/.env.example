# One role per service. Each role uses its own Slack app in Socket Mode.
BOT_ROLE=cyrus
BOT_NAME=Cyrus
SLACK_APP_TOKEN=xapp-replace-me
SLACK_BOT_TOKEN=xoxb-replace-me
# Startup fails if the token authenticates as a different bot. Set per service.
EXPECTED_SLACK_BOT_USER_ID=U_REPLACE_WITH_THIS_BOTS_USER_ID
BLAIR_SLACK_USER_ID=U_REPLACE_ME

# Comma-separated public or private Slack channel IDs the role may read for evidence.
# Direct-message channel IDs are deliberately rejected by the history tool.
SLACK_ALLOWED_CHANNEL_IDS=C_REPLACE_ME
BOT_SOCKET_ENABLED=true

OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_OUTPUT_TOKENS=1200

# Mount this path on a Railway persistent volume. Use a separate volume per role.
BOT_DATA_DIR=/data/cyrus
PORT=3000
INTERNAL_PORT=3001
FOLLOWUP_POLL_MS=15000
CYRUS_AUTONOMY_ENABLED=false
PROACTIVE_MONITORING_ENABLED=false

# Zero-additional-hosting mode. These roles run inside Cyrus's existing service
# while retaining separate SQLite files, prompts, tools, tasks and memory.
SHARED_BOT_ROLES=clara,mateo,kenji,amara,nadia,sloane
SHARED_BOT_DATA_DIR=/data/cyrus/executives

# Existing Slack identities are optional. A role without tokens remains fully
# available through Cyrus but does not open its own direct Slack connection.
CLARA_SLACK_APP_TOKEN=xapp-existing-clara
CLARA_SLACK_BOT_TOKEN=xoxb-existing-clara
CLARA_EXPECTED_SLACK_BOT_USER_ID=U_REPLACE_WITH_COMMAND88_CLARA
# Repeat the ROLE_SLACK_* pattern for Mateo, Kenji, Amara and Nadia.
# Sloane may remain Cyrus-mediated until an existing Slack identity is available.

# Railway-private agent endpoints only. Port 3001 is not exposed by the public domain.
# Malik stays on his existing service. The other six roles are local to Cyrus.
AGENT_PEERS_JSON={"malik":"http://malik-runtime.railway.internal:3001"}

# Optional comma-separated HTTPS origins for read-only checks.
HTTP_READ_ALLOWLIST=https://app.atlasium788.ca,https://linklatch.atlasium788.ca
