# One role per service. Each role uses its own Slack app in Socket Mode.
BOT_ROLE=cyrus
BOT_NAME=Cyrus
SLACK_APP_TOKEN=xapp-replace-me
SLACK_BOT_TOKEN=xoxb-replace-me
# Startup fails if the token authenticates as a different bot. Set per service.
EXPECTED_SLACK_BOT_USER_ID=U_REPLACE_WITH_THIS_BOTS_USER_ID
BLAIR_SLACK_USER_ID=U_REPLACE_ME

# Comma-separated public or private Slack channel IDs the role may read for evidence.
# Direct-message channel IDs are deliberately rejected by the history tool.
SLACK_ALLOWED_CHANNEL_IDS=C_REPLACE_ME
BOT_SOCKET_ENABLED=true

OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Mount this path on a Railway persistent volume. Use a separate volume per role.
BOT_DATA_DIR=/data/cyrus
PORT=3000
INTERNAL_PORT=3001
FOLLOWUP_POLL_MS=15000

# Railway-private agent endpoints only. Port 3001 is not exposed by the public domain.
# Cyrus lists every connected department runtime. Department bots list Cyrus.
AGENT_PEERS_JSON={"cyrus":"http://cyrus-runtime.railway.internal:3001"}

# Optional comma-separated HTTPS origins for read-only checks.
HTTP_READ_ALLOWLIST=https://app.atlasium788.ca,https://linklatch.atlasium788.ca
